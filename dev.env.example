# SQLite file. scripts/worktree-setup.py writes an absolute path.
DATABASE_URL=.db/dev.sqlite
PORT=3000
UI_PORT=5173
UI_PORT_HTTP=5174
PROCESS_COMPOSE_PORT=8180
RAMEKIN_SELF_SIGNED_URL=https://localhost:5173
RUST_LOG=info
INSECURE_PASSWORD_HASHING=1

# OpenTelemetry configuration (optional)
# OTLP endpoint (e.g., http://localhost:4317 for local SigNoz)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# For SigNoz Cloud, add your ingestion key:
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
# Service name shown in SigNoz
# OTEL_SERVICE_NAME=ramekin-server-dev

# AI configuration (optional; imports save recipes without normalize ops when unset)
# Set a real key to enable normalize ops. Do not use a placeholder value.
# OPENROUTER_API_KEY=
# Model for tags, titles and descriptions (defaults to google/gemini-3.8-flash; see make ai-eval)
# RAMEKIN_AI_MODEL=google/gemini-3.8-flash
# Image model for manual recipe photo generation (defaults to google/gemini-3.1-flash-image; see make ai-eval)
# RAMEKIN_AI_IMAGE_MODEL=google/gemini-3.1-flash-image
# Image quality, auto/low/medium/high, for models that take it (defaults to the model's own)
# RAMEKIN_AI_IMAGE_QUALITY=high
# Model for ingredient names and weights (defaults to anthropic/claude-opus-5.5; see make ai-eval)
# RAMEKIN_AI_INGREDIENT_MODEL=anthropic/claude-opus-5.5
# Model for recipe extraction from pasted text and photos (defaults to anthropic/claude-sonnet-5.5; see make ai-eval)
# RAMEKIN_AI_EXTRACTION_MODEL=anthropic/claude-sonnet-5.5
# Model for Edit with AI (defaults to anthropic/claude-opus-5.5; see make ai-eval)
# RAMEKIN_AI_EDIT_MODEL=anthropic/claude-opus-5.5

# External URL used for all user-facing links: QR codes, bookmarklet "View Recipe"
# buttons, recipe URLs shown in the capture overlay. Required — dev/build fails
# if unset. In local dev this points at the self-signed UI origin.
# Database backups (optional, but set this on the machine that runs prod).
# The server writes a consistent snapshot here once an hour and deletes
# snapshots older than 7 days, and copies new stored files (photos and fetched
# pages, which live in <DATABASE_URL>-files/) into its files/ folder. Point it
# at a folder that is synced or mounted off this machine. `make db-backup`
# takes one on demand.
# RAMEKIN_BACKUP_DIR=/path/to/synced/ramekin-backups

RAMEKIN_EXTERNAL_URL=https://localhost:5173
