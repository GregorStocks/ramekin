DATABASE_URL=postgres://ramekin:ramekin@localhost:54321/ramekin
PORT=3000
UI_PORT=5173
UI_PORT_HTTP=5174
PROCESS_COMPOSE_PORT=8180
UI_HOSTNAME=localhost
RUST_LOG=info
INSECURE_PASSWORD_HASHING=1

# OpenTelemetry configuration (optional)
# OTLP endpoint (e.g., http://localhost:4317 for local SigNoz)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# For SigNoz Cloud, add your ingestion key:
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
# Service name shown in SigNoz
# OTEL_SERVICE_NAME=ramekin-server-dev

# AI configuration (required for recipe enrichment)
OPENROUTER_API_KEY=sk-or-...
# Model to use (defaults to google/gemini-2.5-flash)
# RAMEKIN_AI_MODEL=google/gemini-2.5-flash
# Image model to use for manual recipe photo generation (defaults to google/gemini-2.5-flash-image)
# RAMEKIN_AI_IMAGE_MODEL=google/gemini-2.5-flash-image
