# CLI environment configuration
# Copy this file to cli.env and fill in the values.

# OpenRouter API key (required for AI features)
OPENROUTER_API_KEY=sk-or-...

# Model to use (optional, defaults to google/gemini-2.5-flash)
# RAMEKIN_AI_MODEL=google/gemini-2.5-flash

# Other available models:
# - openai/gpt-4.1-mini (OpenAI)
# - anthropic/claude-sonnet-4.6 (Claude)
# - google/gemini-3-flash-preview (newer Gemini)
# Full list at https://openrouter.ai/models
