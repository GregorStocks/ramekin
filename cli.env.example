# CLI environment configuration
# Copy this file to cli.env and fill in the values.

# OpenRouter API key (required for AI features)
# Set a real key before enabling AI features.
# OPENROUTER_API_KEY=

# Models (optional). The extraction and ingredient defaults were chosen with
# `make ai-eval`; see data/ai-evals/ for the results and the models compared.
# General model: tags, titles, descriptions, custom enrich
# RAMEKIN_AI_MODEL=google/gemini-2.5-flash
# Recipe extraction from pasted text and photos
# RAMEKIN_AI_EXTRACTION_MODEL=anthropic/claude-sonnet-5.5
# Ingredient names and weights
# RAMEKIN_AI_INGREDIENT_MODEL=anthropic/claude-opus-5.5
# Recipe photo generation
# RAMEKIN_AI_IMAGE_MODEL=google/gemini-2.5-flash-image
# Full list at https://openrouter.ai/models
