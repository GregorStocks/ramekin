        "roast-chicken",
        "cheesy-garlic-bread-bites",
        "garlic-bread"
      ]
    },
    {
      "name": "bare text does not match tags",
      "query": "garlicky",
      "expected_ids": []
    },
    {
      "name": "ingredient section text matches",
      "query": "garnish",
      "expected_ids": [
        "garlic-bread"
      ]
    },
    {
      "name": "measurement amounts and units match and score",
      "query": "cups flour",
      "expected_ids": [
        "pancakes"
      ]
    },
    {
      "name": "unknown filter prefix is a literal text term",
      "query": "foo:bar",
      "expected_ids": []
    },
    {
      "name": "tag equality is case-insensitive",
      "query": "tag:dinner",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "tag equality is accent-sensitive: unaccented query does not match",
      "query": "tag:creme",
      "expected_ids": []
    },
    {
      "name": "tag equality with matching accents",
      "query": "tag:crème",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "tag equality folds case but keeps accents",
      "query": "tag:CRÈME",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "quoted tag value",
      "query": "tag:\"course/side\"",
      "expected_ids": [
        "garlic-bread"
      ]
    },
    {
      "name": "multiple tags AND to nothing when no recipe has both",
