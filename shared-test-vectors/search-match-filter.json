  "cases": [
    {
      "name": "multi-token AND across fields with relevance order",
      "query": "garlic bread",
      "expected_ids": [
        "garlic-bread",
        "cheesy-garlic-bread-bites",
        "roast-chicken"
      ]
    },
    {
      "name": "ascii query matches accented recipe",
      "query": "creme brulee",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "accented query matches identically",
      "query": "crème brûlée",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "ligature title matches ascii query",
      "query": "oeufs",
      "expected_ids": [
        "oeufs-en-meurette"
      ]
    },
    {
      "name": "presentation-form ligature in ingredient matches ascii query",
      "query": "finely",
      "expected_ids": [
        "hot-cocoa"
      ]
    },
    {
      "name": "vulgar fraction normalizes to ascii on both sides",
      "query": "1/2 pounds",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "quoted phrase is one token",
      "query": "\"green beans\"",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "ILIKE metacharacters are literal, not wildcards",
      "query": "100%",
      "expected_ids": [
        "hot-cocoa"
      ]
    },
    {
      "name": "fullwidth percent matches a literal percent after normalization",
      "query": "100％",
      "expected_ids": [
        "hot-cocoa"
      ]
    },
    {
      "name": "token found only in ingredient JSON keys matches but scores zero",
      "query": "measurements",
      "expected_ids": [
        "pancakes",
        "hot-cocoa",
        "weeknight-pasta",
        "oeufs-en-meurette",
        "green-beans-amandine",
        "creme-brulee",
        "roast-chicken",
        "cheesy-garlic-bread-bites",
        "garlic-bread"
      ]
    },
    {
      "name": "bare text does not match tags",
      "query": "garlicky",
      "expected_ids": []
    },
    {
      "name": "ingredient section text matches",
      "query": "garnish",
      "expected_ids": [
        "garlic-bread"
      ]
    },
    {
      "name": "measurement amounts and units match and score",
      "query": "cups flour",
      "expected_ids": [
        "pancakes"
      ]
    },
    {
      "name": "unknown filter prefix is a literal text term",
      "query": "foo:bar",
      "expected_ids": []
    },
    {
      "name": "tag equality is case-insensitive",
      "query": "tag:dinner",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "tag equality is accent-sensitive: unaccented query does not match",
      "query": "tag:creme",
      "expected_ids": []
    },
    {
      "name": "tag equality with matching accents",
      "query": "tag:crème",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "tag equality folds case but keeps accents",
      "query": "tag:CRÈME",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "quoted tag value",
      "query": "tag:\"course/side\"",
      "expected_ids": [
        "garlic-bread"
      ]
    },
    {
      "name": "multiple tags AND to nothing when no recipe has both",
      "query": "tag:dinner tag:course/side",
      "expected_ids": []
    },
    {
      "name": "text and tag filter combine",
      "query": "bread tag:course/main",
      "expected_ids": [
