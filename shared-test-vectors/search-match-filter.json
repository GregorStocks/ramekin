  "cases": [
    {
      "name": "multi-token AND across fields with relevance order",
      "query": "garlic bread",
      "expected_ids": [
        "garlic-bread",
        "cheesy-garlic-bread-bites",
        "roast-chicken"
      ]
    },
    {
      "name": "ascii query matches accented recipe",
      "query": "creme brulee",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "accented query matches identically",
      "query": "crème brûlée",
      "expected_ids": [
        "creme-brulee"
      ]
    },
    {
      "name": "ligature title matches ascii query",
      "query": "oeufs",
      "expected_ids": [
        "oeufs-en-meurette"
      ]
    },
    {
      "name": "presentation-form ligature in ingredient matches ascii query",
      "query": "finely",
      "expected_ids": [
        "hot-cocoa"
      ]
    },
    {
      "name": "vulgar fraction normalizes to ascii on both sides",
      "query": "1/2 pounds",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "quoted phrase is one token",
      "query": "\"green beans\"",
      "expected_ids": [
        "green-beans-amandine"
      ]
    },
    {
      "name": "ILIKE metacharacters are literal, not wildcards",
      "query": "100%",
      "expected_ids": [
        "hot-cocoa"
      ]
    },
    {
      "name": "token found only in ingredient JSON keys matches but scores zero",
      "query": "measurements",
      "expected_ids": [
        "pancakes",
        "hot-cocoa",
        "weeknight-pasta",
        "oeufs-en-meurette",
        "green-beans-amandine",
